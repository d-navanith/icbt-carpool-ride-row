# ===================================================
# ICBT Campus Carpooling Platform (.env.example)
# Copy this file to .env and configure strong secrets
# ===================================================

# Environment
NODE_ENV=production
PORT=5000

# Security & JWT Token Secrets (REQUIRED - MUST BE SET)
JWT_SECRET=your_super_strong_cryptographic_jwt_secret_change_me
JWT_EXPIRES_IN=7d

# Campus Emergency Security Hotline
SECURITY_HOTLINE="+94 11 584 8888"

# Client URL (for CORS & Socket.io)
CLIENT_URL="http://localhost:5173"
